# adifedit editor baseline. https://editorconfig.org
# Understood natively by VS Code, and by Vim/Neovim, Emacs, CLion, etc.
# with the editorconfig plugin. clang-format (.clang-format) is the
# authority on C layout; this file just covers the basics and non-C files.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{c,h}]
indent_size = 4
max_line_length = 100

[{CMakeLists.txt,*.cmake,*.cmake.in}]
indent_size = 4

[*.sh]
indent_size = 4

[*.{json,xml,desktop}]
indent_size = 2

[*.md]
indent_size = 2
# Markdown uses two trailing spaces for a hard line break.
trim_trailing_whitespace = false
